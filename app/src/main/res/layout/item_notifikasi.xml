<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="0dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/hycoms_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:id="@+id/unreadAccent"
            android:layout_width="4dp"
            android:layout_height="50dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_notification_unread_accent" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="0"
            android:foregroundGravity="center">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_notification_icon_circle">

                <ImageView
                    android:id="@+id/imgNotifIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_notifications_hycoms" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/judulNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppinsbold"
                android:text="Judul Notifikasi"
                android:textColor="@color/hycoms_primary_green"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/detailNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppinsregular"
                android:lineSpacingExtra="3dp"
                android:text="Detail Notifikasi"
                android:textColor="@color/hycoms_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/timeNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Baru saja"
                android:textColor="@color/hycoms_timestamp"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
