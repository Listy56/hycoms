<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <!-- Header Area dengan Gradient Background -->
    <ImageView
        android:id="@+id/imgHeaderBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_auth_header_gradient"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@id/scrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decorative Leaf/Circle (Optional) -->
    <ImageView
        android:id="@+id/imgDecor"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:alpha="0.2"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_auth_leaf"
        app:layout_constraintEnd_toEndOf="@id/imgHeaderBackground"
        app:layout_constraintTop_toTopOf="@id/imgHeaderBackground" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="@id/imgHeaderBackground"
        app:layout_constraintTop_toTopOf="@id/imgHeaderBackground"
        android:layout_margin="24dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:text="Create Username"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppinsregular"
        app:layout_constraintEnd_toEndOf="@id/imgHeaderBackground"
        app:layout_constraintStart_toStartOf="@id/imgHeaderBackground"
        app:layout_constraintTop_toBottomOf="@id/imgLogo" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:text="Choose your unique username"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="normal"
        android:fontFamily="@font/poppinsregular"
        android:alpha="0.8"
        app:layout_constraintEnd_toEndOf="@id/imgHeaderBackground"
        app:layout_constraintStart_toStartOf="@id/imgHeaderBackground"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Main ScrollView untuk Form -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgHeaderBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Username Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Widget.HYCOMS.Auth.TextInputLayout"
                app:boxStrokeColor="@color/auth_input_stroke"
                app:startIconDrawable="@drawable/ic_auth_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:hint="Username"
                    android:inputType="text"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Continue Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:text="Continue"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:cornerRadius="@dimen/auth_radius"
                app:backgroundTint="@color/auth_primary_green"
                app:elevation="6dp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.HYCOMS.Auth.PrimaryButton" />

            <!-- Cancel Button (Outlined) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:text="Cancel"
                android:textColor="@color/auth_text_primary"
                android:textSize="18sp"
                app:cornerRadius="@dimen/auth_radius"
                app:backgroundTint="@color/auth_background"
                app:strokeColor="@color/auth_light_green"
                app:strokeWidth="1.5dp"
                style="@style/Widget.HYCOMS.Auth.GoogleButton" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>