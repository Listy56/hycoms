<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/auth_background"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HEADER HICS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_header_hy"
        android:minHeight="180dp"
        android:orientation="horizontal"
        android:weightSum="10">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

        <LinearLayout
            android:id="@+id/headerCenter"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_weight="9.5"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/leaf" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="219dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="25sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppinsbold"
                android:text="Welcome Back"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppinsregular"
                android:text="Login to continue"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main ScrollView untuk Form -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Email / Username -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.HYCOMS.Auth.TextInputLayout"
                app:boxStrokeColor="@color/auth_input_stroke"
                app:startIconDrawable="@drawable/ic_auth_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:hint="Email or Username"
                    android:inputType="textEmailAddress"
                    android:textSize="16sp"
                    style="@style/TextAppearance.HYCOMS.Auth.Input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.HYCOMS.Auth.TextInputLayout"
                app:boxStrokeColor="@color/auth_input_stroke"
                app:startIconDrawable="@drawable/ic_auth_lock"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_input_height"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:textSize="16sp"
                    style="@style/TextAppearance.HYCOMS.Auth.Input" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="@color/auth_forgot"
                android:textSize="14sp"
                android:gravity="end"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:text="Login"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="@dimen/auth_radius"
                app:backgroundTint="@color/auth_primary_green"
                app:elevation="6dp"
                android:layout_marginBottom="20dp"
                style="@style/Widget.HYCOMS.Auth.PrimaryButton" />

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/auth_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  OR  "
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/auth_divider" />
            </LinearLayout>

            <!-- Google Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginGoogle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:text="Continue with Google"
                android:textColor="@color/auth_text_primary"
                android:textSize="16sp"
                app:cornerRadius="@dimen/auth_radius"
                app:backgroundTint="@color/auth_background"
                app:strokeColor="@color/auth_light_green"
                app:strokeWidth="1.5dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.HYCOMS.Auth.GoogleButton" />

            <!-- Footer - Don't have account? -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account?  "
                    style="@style/TextAppearance.HYCOMS.Auth.Footer" />

                <TextView
                    android:id="@+id/tvSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Up"
                    android:clickable="true"
                    android:focusable="true"
                    style="@style/TextAppearance.HYCOMS.Auth.FooterLink" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>


