<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home">

    <!-- HEADER -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="72dp">

        <!-- Background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_notification_appbar" />

        <!-- Content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Back -->

            <!-- Back -->

            <FrameLayout
                android:id="@+id/backContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_notification_icon_circle">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/back"
                    app:tint="@color/hycoms_primary_green"/>

            </FrameLayout>


            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppinsbold"
                android:text="Kontrol"
                android:textColor="@color/hycoms_text_primary"
                android:textSize="20sp" />

        </RelativeLayout>

    </FrameLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- PASTE SEMUA ISI CONTROL DI SINI -->

            <!-- MODE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardUseCompatPadding="true"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
]

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Mode : "
                        android:textColor="#2E7D5B"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Otomatis"
                        android:textColor="#2E7D5B"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <LinearLayout
                        android:id="@+id/switchMode"
                        android:layout_width="50dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <View
                            android:id="@+id/circleMode"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_circle" />
                    </LinearLayout>

                </LinearLayout>

                <!-- isi mode -->
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvStatusMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppinsregular"
                android:text="Sistem berjalan otomatis berdasarkan threshold"
                android:textColor="#666666"
                android:textSize="10sp"
                android:textStyle="italic" />

            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- POMPA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/pumpLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/pompa_air" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinmedium"
                            android:text="Pompa Air"
                            android:textColor="#2E7D5B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/switchPump"
                            android:layout_width="50dp"
                            android:layout_height="26dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_switch_off"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <View
                                android:id="@+id/circlePump"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_circle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinsbold"
                            android:text="-"
                            android:textColor="#2E7D5B"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- PH UP -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/phUpLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ph_up" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinmedium"
                            android:text="Penambah pH"
                            android:textColor="#2E7D5B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/switchPhUp"
                            android:layout_width="50dp"
                            android:layout_height="26dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_switch_off"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <View
                                android:id="@+id/circlePhUp"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_circle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusPhUp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinsbold"
                            android:text="-"
                            android:textColor="#2E7D5B"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- PH DOWN -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/phDownLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ph_down" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinmedium"
                            android:text="Penurun pH"
                            android:textColor="#2E7D5B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/switchPhDown"
                            android:layout_width="50dp"
                            android:layout_height="26dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_switch_off"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <View
                                android:id="@+id/circlePhDown"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_circle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusPhDown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinsbold"
                            android:text="-"
                            android:textColor="#2E7D5B"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- NUTRISI UP -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/nutrisiUpLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/nutrisi_up" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinmedium"
                            android:text="Nutrisi A"
                            android:textColor="#2E7D5B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/switchNutrisiUp"
                            android:layout_width="50dp"
                            android:layout_height="26dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_switch_off"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <View
                                android:id="@+id/circleNutrisiUp"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_circle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusNutrisiUp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinsbold"
                            android:text="-"
                            android:textColor="#2E7D5B"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- NUTRISI DOWN -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/nutrisiDownLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/nutrisi_down" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinmedium"
                            android:text="Nutrisi B"
                            android:textColor="#2E7D5B"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/switchNutrisiDown"
                            android:layout_width="50dp"
                            android:layout_height="26dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_switch_off"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <View
                                android:id="@+id/circleNutrisiDown"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_circle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusNutrisiDown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppinsbold"
                            android:text="-"
                            android:textColor="#2E7D5B"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>


