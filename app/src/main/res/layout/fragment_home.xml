<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingLeft="21dp"
    android:paddingRight="21dp"
    android:paddingTop="0dp"
    android:paddingBottom="21dp">


    <!-- ================= TOP CARD ================= -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        android:layout_marginBottom="21dp"
        app:cardElevation="1dp"
        app:strokeColor="#6B8F7A"
        app:strokeWidth="0.8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cardwater"
            android:clipToOutline="true"
            android:padding="20dp">

            <!-- TITLE -->

            <LinearLayout
                android:id="@+id/topTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/water" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Water Availability"
                    android:textColor="#244636"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinsbold" />

            </LinearLayout>

            <!-- PERCENT -->

            <TextView
                android:id="@+id/waterLevelPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topTitle"
                android:layout_marginTop="18dp"
                android:text="72%"
                android:textColor="#2E7D5B"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeStepGranularity="2sp"
                android:fontFamily="@font/poppinsbold" />

            <!-- STATUS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/waterLevelPercent"
                android:layout_marginTop="4dp"
                android:text="Status: Safe"
                android:textColor="#244636"
                android:textSize="13sp"
                android:fontFamily="@font/poppinsregular" />

            <!-- WATER BAR -->

            <LinearLayout
                android:id="@+id/baseWaterLevel"
                android:layout_width="48dp"
                android:layout_height="120dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_air_putih"
                android:gravity="bottom"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/waterLevel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_air_hijau" />

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= 3 CARD ROW ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="21dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- WATER PUMP -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="21dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeColor="#6B8F7A"
            app:strokeWidth="0.8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/pompa_air" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Water Pump"
                    android:textColor="#244636"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppinsbold" />

                <Switch
                    android:id="@+id/switchPompa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/statusSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON"
                    android:textColor="#2E7D5B"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="2sp"
                    android:fontFamily="@font/poppinsbold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- NUTRITION -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="21dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeColor="#6B8F7A"
            app:strokeWidth="0.8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/nutrisi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nutrition"
                    android:textColor="#244636"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppinsbold" />

                <TextView
                    android:id="@+id/tvNutrisi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="900"
                    android:textColor="#2E7D5B"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeStepGranularity="2sp"
                    android:fontFamily="@font/poppinsbold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PPM"
                    android:textColor="#2E7D5B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsbold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PH -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeColor="#6B8F7A"
            app:strokeWidth="0.8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ph" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="pH"
                    android:textColor="#244636"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppinsbold" />

                <TextView
                    android:id="@+id/tvPh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="6"
                    android:textColor="#2E7D5B"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="40sp"
                    android:autoSizeStepGranularity="2sp"
                    android:fontFamily="@font/poppinsbold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ================= BOTTOM ROW ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- TEMP CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="21dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeColor="#6B8F7A"
            app:strokeWidth="0.8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cardtemp"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/suhu" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Temp. &amp; Air"
                        android:textColor="#244636"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppinsbold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Udara"
                        android:textColor="#244636"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/airTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="21dp"
                        android:text="20 C"
                        android:textColor="#2E7D5B"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="2sp"
                        android:fontFamily="@font/poppinsbold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Air"
                        android:textColor="#244636"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/waterTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="38dp"
                        android:text="20 C"
                        android:textColor="#2E7D5B"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="2sp"
                        android:fontFamily="@font/poppinsbold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- LUX CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeColor="#6B8F7A"
            app:strokeWidth="0.8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_luxcard"
                android:clipToOutline="true"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/lightHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/cahaya" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Intensity"
                        android:textColor="#244636"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppinsbold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvIntensitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="30dp"
                    android:text="900"
                    android:textColor="#2E7D5B"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeStepGranularity="2sp"
                    android:fontFamily="@font/poppinsbold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvIntensitas"
                    android:layout_centerHorizontal="true"
                    android:text="LUX"
                    android:textColor="#2E7D5B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinsbold" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
  